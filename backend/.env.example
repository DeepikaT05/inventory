DATABASE_URL="postgresql://mandi:mandi@localhost:5432/mandi_ledger?schema=public"
PORT=4000
# Optional. When set, every /api request must send header  x-api-key: <value>
API_KEY=
# Shop's timezone offset from UTC in minutes (India = 330). Used for "today" and daily reports.
TZ_OFFSET_MINUTES=330
# Secret key for signing JWT tokens. Change this in production!
JWT_SECRET=change-me-in-production-use-a-long-random-string
# Super-admin credentials for the seed script (npx tsx src/seed-admin.ts)
ADMIN_EMAIL=admin@mandiledger.com
ADMIN_PASSWORD=admin123
ADMIN_NAME=Super Admin
